<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_code_block"
    android:backgroundTint="#ffffff"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Bar with Close 'X' and Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnCloseContactSupport"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_stop"
            app:tint="#666666" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Contact Support"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Field 1: Your Name -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Your Name"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContactName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/edit_text_border"
        android:hint="Enter your name"
        android:inputType="textPersonName"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="14sp" />

    <!-- Field 2: Email Address -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Email Address"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContactEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/edit_text_border"
        android:hint="Enter your email address"
        android:inputType="textEmailAddress"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="14sp" />

    <!-- Field 3: Feedback or Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Feedback or Message"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContactMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/edit_text_border"
        android:gravity="top"
        android:hint="Type your message here..."
        android:inputType="textMultiLine"
        android:minLines="4"
        android:padding="12dp"
        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="14sp" />

    <!-- Submit Button (Full width blue button matching Video 1) -->
    <Button
        android:id="@+id/btnSubmitContactSupport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#1a73e8"
        android:text="SEND MESSAGE"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>